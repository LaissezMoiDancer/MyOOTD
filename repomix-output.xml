import { AppStep, UserPhoto, StyleAnalysis, OutfitRecommendation, StylePreferences } from './types';

const STANDARD_COLORS = [
  { name: 'Noir', hex: '#000000' },
  { name: 'Albâtre', hex: '#FFFFFF' },
